{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // The vendored engine imports its wire types as "@shared/types/Game", the
    // specifier they carry in TacticToes. Re-pointing the alias is how
    // VENDOR.md says to vendor them — it keeps the copies byte-identical.
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/engine-vendor/shared/*"] },
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "sourceMap": false
    }
  }
}