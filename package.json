{
  "name": "chris-centaur",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node --max-old-space-size=512 dist/index.js",
    "dev": "NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true node --watch --max-old-space-size=512 -r ts-node/register src/index.ts",
    "dev:fast": "npm run build && concurrently \"npm run build:watch\" \"nodemon --watch dist --exec 'node --max-old-space-size=512 dist/index.js'\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "battlesnake",
    "ai",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "TypeScript Battlesnake AI using Voronoi territory maximization",
  "dependencies": {
    "compression": "^1.8.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "firebase": "^10.14.1",
    "pg": "^8.16.3",
    "ws": "^8.19.0"
  },
  "overrides": {
    "glob": "^11.1.0",
    "minimatch": "^10.2.1",
    "jws": "3.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "playwright": "^1.62.1",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
