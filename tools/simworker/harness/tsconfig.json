{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "build",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/engine-vendor/shared/*"] },
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "bin/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/tests/**",
    "src/**/__tests__/**",
    "node_modules"
  ]
}
