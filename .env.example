# Battlesnake AI Weight Configuration
# Copy this file to .env to customize weights

# My Snake Weights
WEIGHT_MY_LENGTH=10
WEIGHT_MY_TERRITORY=1
WEIGHT_MY_CONTROLLED_FOOD=10

# Team Weights
WEIGHT_TEAM_LENGTH=10
WEIGHT_TEAM_TERRITORY=1
WEIGHT_TEAM_CONTROLLED_FOOD=10

# Distance/Proximity Weights
WEIGHT_FOOD_PROXIMITY=50

# Enemy Weights (currently unused but tracked)
WEIGHT_ENEMY_TERRITORY=0
WEIGHT_ENEMY_LENGTH=0

# Life/Death Weights
WEIGHT_KILLS=0
WEIGHT_DEATHS=-500
# TacticToes Firebase interface — the centaur's ONLY game transport (see
# README.md). All four vars are required; without them the process serves the
# centaur web UI only and cannot play. The centaur signs in to Firebase as a
# centaur principal and stages every move through Firestore writes; the game
# server resolves each turn with the last staged move before the turn deadline.
TACTICTOES_CENTAUR_ID=
TACTICTOES_CENTAUR_API_KEY=
TACTICTOES_FIREBASE_PROJECT_ID=
TACTICTOES_FIREBASE_API_KEY=
# Optional: region of the TacticToes Cloud Functions
TACTICTOES_FUNCTIONS_REGION=us-central1
