# Battlesnake AI Weight Configuration
# Copy this file to .env to customize weights

# My Snake Weights
WEIGHT_MY_LENGTH=10
WEIGHT_MY_TERRITORY=1
WEIGHT_MY_CONTROLLED_FOOD=10

# Team Weights
WEIGHT_TEAM_LENGTH=10
WEIGHT_TEAM_TERRITORY=1
WEIGHT_TEAM_CONTROLLED_FOOD=10

# Distance/Proximity Weights
WEIGHT_FOOD_PROXIMITY=50

# Enemy Weights (currently unused but tracked)
WEIGHT_ENEMY_TERRITORY=0
WEIGHT_ENEMY_LENGTH=0

# Life/Death Weights
WEIGHT_KILLS=0
WEIGHT_DEATHS=-500
# TacticToes direct-Firebase interface (optional; all four required vars must
# be set to enable it). Create the bot + API key in TacticToes, then the bot
# signs in to Firebase itself and stages moves through Firestore instead of
# waiting for Battlesnake HTTP pokes.
TACTICTOES_BOT_ID=
TACTICTOES_BOT_API_KEY=
TACTICTOES_FIREBASE_PROJECT_ID=
TACTICTOES_FIREBASE_API_KEY=
# Optional tuning
TACTICTOES_FUNCTIONS_REGION=us-central1
# immediate | buffered | never — when to add the snake to movedPlayerIDs.
# buffered (default) commits commitBufferMs before the turn deadline, keeping
# the re-staging window open as long as possible.
TACTICTOES_COMMIT_MODE=buffered
TACTICTOES_COMMIT_BUFFER_MS=2000
